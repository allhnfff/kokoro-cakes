{
    "name": "kokoro-cakes/web-ordering",
    "description": "Website pemesanan menu dan manajemen meja Kokoro Cakes (tugas individu) dengan PHP dan Redis",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "chillerlan/php-qrcode": "^5.0",
        "predis/predis": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/index.php",
        "seed": "php scripts/seed-demo.php",
        "check": "php scripts/check-redis.php",
        "test": "php tests/run-tests.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    }
}
