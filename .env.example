# =====================================================================
# CONTOH KONFIGURASI WEBSITE KOKORO CAKES
# Salin file ini menjadi ".env" lalu sesuaikan. File .env TIDAK masuk Git.
# Jangan menulis password asli di file .env.example.
# =====================================================================

# ---- Aplikasi ----
# local / testing / production. Seeder data demo hanya boleh di local atau testing.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
# Kunci rahasia untuk tautan QR meja. Jangan isi manual, jalankan: php scripts/generate-key.php
APP_KEY=

# ---- Identitas kafe (data demo, bukan alamat usaha nyata) ----
STORE_NAME="Kokoro Cakes"
STORE_TAGLINE="Japanese cake & tea house"
STORE_ADDRESS=""
STORE_HOURS="10.00–21.00 WIB"
# Wi-Fi tamu (opsional). Kosongkan jika tidak ingin ditampilkan di beranda.
STORE_WIFI_NAME=
STORE_WIFI_PASSWORD=
DEVELOPER_NAME=

# Nama cookie sesi. WAJIB beda dengan proyek lain yang berjalan di localhost.
SESSION_NAME=KOKORO_SESS
# file (laptop) atau redis (wajib di Vercel/serverless: sesi disimpan di Redis, key sess:{id})
SESSION_DRIVER=file
# true jika web di belakang proxy HTTPS tepercaya (Vercel): X-Forwarded-Proto dipakai untuk cookie Secure
TRUST_PROXY=false
# Interval pembaruan otomatis (ms). Versi online: menu 60000, pesanan & kasir 15000 agar hemat kuota Upstash.
MENU_POLL_MS=5000
ORDER_POLL_MS=5000
KASIR_POLL_MS=5000

# ---- Biaya ----
# Pajak/biaya layanan dalam persen (bilangan bulat 0–100). Contoh dari wireframe: 10.
# Ini bukan tarif usaha yang sudah dikonfirmasi; ubah sesuai kebutuhan.
TAX_PERCENT=10
# Pesanan "bayar di kasir" dibatalkan otomatis jika belum dibayar dalam sekian menit (5–120).
ORDER_UNPAID_MINUTES=15

# ---- Redis ----
# REDIS_SCHEME: tcp (lokal) atau tls (server dengan TLS).
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Kosongkan jika Redis lokal tanpa password/ACL.
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=3
# Database khusus tes otomatis (dikosongkan oleh tes). Harus berbeda dari REDIS_DB.
REDIS_TEST_DB=15

# ---- Akun kasir awal (dipakai SEKALI oleh php scripts/seed-demo.php) ----
SEED_KASIR_NAMA="Kasir Kokoro"
# Username untuk login kasir (login staf memakai username, bukan email)
SEED_KASIR_USERNAME=kasir
SEED_KASIR_EMAIL=kasir@kokoro.test
# WAJIB diisi sendiri sebelum seed, 8–72 byte. Yang disimpan di Redis hanya hash-nya.
# Sesudah seed boleh dikosongkan lagi. Ganti password kasir: php scripts/set-kasir-password.php
SEED_KASIR_PASSWORD=

# ---- Akun admin (kelola menu, ganti QR meja), dibuat dengan: php scripts/create-admin.php ----
SEED_ADMIN_NAMA="Admin Kokoro"
# Username untuk login admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@kokoro.test
# WAJIB diisi sendiri, 8–72 byte, berbeda dari password kasir. Yang disimpan hanya hash-nya.
SEED_ADMIN_PASSWORD=

# ---- Preview lokal di dalam iframe (misalnya Mobile Preview) ----
# Bawaan false: website menolak dibingkai (X-Frame-Options DENY, frame-ancestors 'none').
# true HANYA berlaku jika APP_ENV=local. Yang berubah hanya aturan pembingkaian.
LOCAL_PREVIEW_FRAME=false
# Daftar asal yang boleh membingkai, dipisah spasi. Kosong = 'self' http://localhost:* http://127.0.0.1:* vscode-webview: chrome-extension:
LOCAL_PREVIEW_FRAME_ANCESTORS=
